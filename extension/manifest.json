{
  "manifest_version": 3,
  "name": "FocusTrack",
  "version": "1.2.1",
  "description": "FocusTrack widgets in your browser's side panel and toolbar, and website tracking for the FocusTrack desktop app (domains only). Your own new tab page stays exactly as it is.",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:17865/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "FocusTrack",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "focustrack@focustrack.app",
      "strict_min_version": "121.0"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "FocusTrack",
    "default_icon": {
      "32": "icons/32.png"
    },
    "open_at_install": false
  }
}
