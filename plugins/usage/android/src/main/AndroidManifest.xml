<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen time: which app was in front, and when. The user grants this in
         Settings > Usage access; Android never grants it automatically. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- App names for apps people open from the launcher (not every package). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Which apps are home screens (their time isn't counted as app use). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <!-- Blocking (#69): Android tells this service which app comes to the
             front (package name only, never window contents); FocusTrack then
             shows its block screen over apps that are over their limit or blocked
             by a focus session. Off until the user turns it on after FocusTrack's
             explanation (Settings > Accessibility). -->
        <service
            android:name="com.focustrack.usage.BlockerService"
            android:exported="true"
            android:label="@string/focustrack_blocker_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focustrack_blocker" />
        </service>

        <activity
            android:name="com.focustrack.usage.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.focustrack.blocker"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
